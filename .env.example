# Cloudflare credentials for the Sei chat interface only.
# The audit-reference MCP does not need these settings.
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# Use a model supported by your Cloudflare account.
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Sei CLI logging: error, warn, info, debug, trace.
LOG_LEVEL=info
