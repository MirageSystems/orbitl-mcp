{
  "name": "orbitl",
  "version": "1.0.0",
  "description": "Historical audit findings for Web3 security review, served over MCP",
  "type": "module",
  "main": "dist/mcp/cli.js",
  "bin": {
    "orbitl": "dist/mcp/cli.js",
    "orbitl-mcp": "dist/mcp/cli.js",
    "orbitl-findings": "dist/retrieval/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.js",
    "scripts/export-findings.py",
    "README.md",
    "ARCHITECTURE.md",
    "CONTEXT.md",
    "TESTING.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "docs/MCP-SETUP.md",
    "examples"
  ],
  "scripts": {
    "dev": "tsx src/mcp/cli.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node dist/mcp/cli.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "findings": "tsx src/retrieval/cli.ts",
    "test:retrieval": "npm run build && tsx --test src/retrieval/findings.test.ts",
    "mcp": "node dist/mcp/cli.js",
    "test:mcp": "npm run build && tsx --test src/mcp/*.test.ts",
    "test": "npm run build && tsx --test src/retrieval/*.test.ts src/mcp/*.test.ts",
    "typecheck": "tsc -p tsconfig.verify.json",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "web3",
    "security",
    "audit-references"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MirageSystems/orbitl-mcp.git"
  },
  "homepage": "https://github.com/MirageSystems/orbitl-mcp#readme",
  "bugs": {
    "url": "https://github.com/MirageSystems/orbitl-mcp/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.4",
    "typescript": "^7.0.2"
  }
}
